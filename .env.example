SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DATABASE_URL=
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=0

PLATFORM_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Must be a model enabled for the same existing platform API key.
SALES_EMAIL_MODEL=gpt-5-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VALIDATE_TWILIO_SIGNATURES=0
PUBLIC_BASE_URL=http://127.0.0.1:8000

DEFAULT_FROM_EMAIL=noreply@aibusinessgurus.com
SERVER_EMAIL=noreply@aibusinessgurus.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

FIELD_ENCRYPTION_KEY=dev-only-change-this-use-fernet-key-in-prod
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_GROWTH=price_placeholder_growth
STRIPE_PRICE_PRO=price_placeholder_pro
OWNER_ALERT_EMAIL=

# Production examples:
# DEBUG=0
# SECRET_KEY=generate-a-long-random-secret-at-least-50-characters
# ALLOWED_HOSTS=aibiz.guru,www.aibiz.guru
# CSRF_TRUSTED_ORIGINS=https://aibiz.guru,https://www.aibiz.guru
# DATABASE_URL=postgres://...
# DB_SSL_REQUIRE=1
# PUBLIC_BASE_URL=https://aibiz.guru
# SECURE_SSL_REDIRECT=1
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=1
# VALIDATE_TWILIO_SIGNATURES=1

# Optional one-time setup fees. Leave blank if setup is invoiced separately.
STRIPE_SETUP_PRICE_STARTER=
STRIPE_SETUP_PRICE_GROWTH=
STRIPE_SETUP_PRICE_PRO=
DEMO_DAILY_AI_LIMIT=100
LEAD_FINDER_ENABLE_PUBLIC_HTTP=1
LEAD_FINDER_PROVIDER_TIMEOUT=12
LEAD_FINDER_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Alternate public OSM host used only for outages/timeouts, never rate-limit bypass.
LEAD_FINDER_OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
# Override only when your proxy chain differs from Render's default appended hop.
# TRUSTED_PROXY_HOPS=1
# Persistent uploads: point MEDIA_ROOT at your existing Render disk mount.
# MEDIA_ROOT=/var/data/media
# Background Lead Finder searches use your existing worker and Redis URL.
# CELERY_BROKER_URL=redis://...

# Runway live video concierge (separate from the Runway media-generation app).
RUNWAYML_API_SECRET=
RUNWAY_AVATAR_ID=
VIDEO_CONCIERGE_ENABLED=0
VIDEO_CONCIERGE_DAILY_LIMIT=20
VIDEO_CONCIERGE_HOURLY_LIMIT=3
VIDEO_CONCIERGE_MAX_SECONDS=300

# Private training video/caption storage. Leave blank until approved media is ready.
TRAINING_S3_BUCKET=
TRAINING_S3_REGION=us-east-1
# Optional HTTPS endpoint for S3-compatible storage.
TRAINING_S3_ENDPOINT=
# Alternative: private media directory on a Render persistent disk.
# Example: /var/data/training (do not expose as public static files).
TRAINING_MEDIA_ROOT=
# The server uses the standard AWS credential chain / workload identity.
# Supply read-only object credentials through Render environment settings if needed.
# Never commit credentials or put them in lesson URLs.

# Deferred transport settings; current email copilot uses copy/paste only.
# Leave these empty. All CRM Gmail/SMS transport routes return 410 in this phase.
SALES_GOOGLE_CLIENT_ID=
SALES_GOOGLE_CLIENT_SECRET=
SALES_GOOGLE_REDIRECT_URI=https://aibiz.guru/crm/outreach/google/callback/
SALES_GOOGLE_DOMAINS=aibiz.guru
# Reserved for a future company sales SMS integration.
SALES_SMS_FROM_NUMBER=
SALES_SMS_MESSAGING_SERVICE_SID=
# Do not configure CRM SMS webhooks while the transport routes are deferred.

# Automotive Experience Center (reuses PLATFORM_OPENAI_API_KEY / OPENAI_API_KEY)
DEMO_CHAT_MODEL=gpt-4o-mini
DEMO_AI_DAILY_LIMIT=600
DEMO_VOICE_DAILY_LIMIT=600
